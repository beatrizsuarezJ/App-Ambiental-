<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.ChildCare" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Evitar que Android fuerce modo oscuro -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Status bar y navbar -->
        <item name="android:statusBarColor">@color/colorStatusBar</item>
        <item name="android:navigationBarColor">@color/colorNavBar</item>

        <!-- Iconos blancos (porque fondo es oscuro) -->
        <item name="android:windowLightStatusBar">false</item>

    </style>
</resources>