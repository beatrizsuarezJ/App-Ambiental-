<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Index_ChildCare"
    android:background="@drawable/fondo">

    <!-- Barra de navegación -->
    <!-- ▒▒▒ FRANJA SUPERIOR MORADA ▒▒▒ -->
    <View
        android:id="@+id/statusBarFake"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="#D7C2FF"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- ▒▒▒ BARRA DE NAVEGACIÓN LAVANDA ▒▒▒ -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#DDE3FF"
        app:layout_constraintTop_toBottomOf="@id/statusBarFake">



        <!-- Texto "ChildCare" -->

        <TextView
            android:id="@+id/childCareText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ECOFOREST"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <!-- Icono de usuario -->
        <ImageView
            android:id="@+id/logOutExitSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:src="@drawable/log_out"
            android:onClick="signOut"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/userActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold|italic" />

    </LinearLayout>

    <!-- Carrusel de imágenes -->

    <!-- Texto largo -->

    <org.imaginativeworld.whynotimagecarousel.ImageCarousel
        android:id="@+id/carousel"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/loremText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/contenedores_diseno"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/textoBienvenidaAdmin"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="30dp"
        android:textStyle="bold|italic"
        app:layout_constraintTop_toBottomOf="@+id/carousel"
        tools:layout_editor_absoluteX="0dp" />

    <Button
        android:id="@+id/btnUbicaionAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#ffffff"
        android:text="@string/asistencia3"
        android:textColor="#000000"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loremText"
        app:layout_constraintVertical_bias="0.20999998" />

    <Button
        android:id="@+id/btnListaPlantas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="210dp"
        android:backgroundTint="#ffffff"
        android:text="Lista de Plantas"
        android:textColor="#000000"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.75"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loremText" />

    <Button
        android:id="@+id/btnRegistroPlantas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="210dp"
        android:backgroundTint="#ffffff"
        android:text="Registro "
        android:textColor="#000000"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loremText" />

</androidx.constraintlayout.widget.ConstraintLayout>
