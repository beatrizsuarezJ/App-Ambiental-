<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_temperatura"
    tools:context=".Formulario_ChildCare_User">

    <!-- Foto -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="25dp"
        android:contentDescription="Imagen del usuario"
        android:padding="16dp"
        android:scaleType="centerCrop"
        android:src="@drawable/usuario_ii"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonChoose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:backgroundTint="#ffffff"
        android:textColor="#000000"
        android:layout_marginStart="10dp"
        android:layout_marginTop="175dp"
        android:text="Seleccionar Img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonChoose"
        android:layout_centerHorizontal="true"
        android:backgroundTint="#ffffff"
        android:textColor="#000000"
        android:layout_marginTop="175dp"
        android:layout_marginEnd="10dp"
        android:text="Enviar Imagen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nombre (S) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nombreInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/App.TextInputLayout"
        android:hint="Nombre(S)"
        app:layout_constraintTop_toBottomOf="@id/imageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nombreEditText"
            style="@style/App.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Apellidos -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/apellidosInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/App.TextInputLayout"
        android:hint="Apellidos"
        app:layout_constraintTop_toBottomOf="@id/nombreInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/apellidosEditText"
            style="@style/App.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Edad -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/edadInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/App.TextInputLayout"
        android:hint="Edad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/apellidosInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edadEditText"
            style="@style/App.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Género -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/generoInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/App.TextInputLayout"
        android:hint="Género"
        app:layout_constraintTop_toBottomOf="@id/edadInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/generoEditText"
            style="@style/App.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Alergia -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/alergiaInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/App.TextInputLayout"
        android:hint="Alergia"
        app:layout_constraintTop_toBottomOf="@id/generoInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/alergiaEditText"
            style="@style/App.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nombre del Padre -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/padreInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/App.TextInputLayout"
        android:hint="Nombre del Padre"
        app:layout_constraintTop_toBottomOf="@id/alergiaInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/padreEditText"
            style="@style/App.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nombre de la Madre -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/madreInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/App.TextInputLayout"
        android:hint="Nombre de la Madre"
        app:layout_constraintTop_toBottomOf="@id/padreInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/madreEditText"
            style="@style/App.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Número Telefónico -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/telefonoInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/App.TextInputLayout"
        android:hint="Número Telefónico"
        app:layout_constraintTop_toBottomOf="@id/madreInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/telefonoEditText"
            style="@style/App.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón Enviar -->
    <Button
        android:id="@+id/btnEnviarDataFormulario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:backgroundTint="#ffffff"
        android:textColor="#000000"
        android:text="Enviar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/telefonoInputLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
