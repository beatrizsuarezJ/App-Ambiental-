<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vista de la Cámara -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Botón Cerrar (Esquina superior izquierda) -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_margin="20dp"
        android:src="@drawable/ic_close"
        android:background="@android:color/transparent"
        android:layout_gravity="top|start" />

    <!-- Botón Flash (Esquina superior derecha) -->
    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_margin="20dp"
        android:src="@drawable/ic_flash_on"
        android:background="@android:color/transparent"
        android:layout_gravity="top|end" />

    <!-- Botón Cambiar Cámara (Frontal ↔ Trasera) -->
    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="25dp"
        android:src="@drawable/ic_switch_camera"
        android:background="@android:color/transparent"
        android:layout_gravity="bottom|end" />

    <!-- Botón Galería (Estilo WhatsApp) -->
    <ImageButton
        android:id="@+id/btnGallery"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="25dp"
        android:src="@drawable/ic_gallery"
        android:background="@android:color/transparent"
        android:layout_gravity="bottom|start" />

    <!-- Botón de Captura Estilo WhatsApp -->
    <ImageButton
        android:id="@+id/btnCapture"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/whatsapp_capture_button" />

</FrameLayout>
