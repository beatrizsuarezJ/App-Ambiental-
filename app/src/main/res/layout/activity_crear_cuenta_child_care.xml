<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CrearCuenta_ChildCare"
    android:background="@drawable/ws">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="185dp"
        android:layout_height="216dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/icon_forest_app" />

    <!-- TITULO -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="350dp"
        android:layout_height="75dp"
        android:layout_marginTop="225dp"
        android:background="@drawable/contenedores_diseno"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/imageView4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="5dp">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/family"
                android:text="@string/crear_cuenta"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="35dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- SCROLL PRINCIPAL -->
    <ScrollView
        android:layout_width="375dp"
        android:layout_height="460dp"
        android:layout_marginTop="290dp"
        android:background="@drawable/contenedores_diseno"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Usuario -->
                <TextView
                    android:id="@+id/txtUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="25dp"
                    android:text="Usuario:"
                    android:textColor="@color/black"
                    android:textSize="14dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNameUsuario"
                    android:layout_width="335dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="5dp"
                    android:hint="Usuario"
                    android:textColor="@color/black"
                    android:textColorHint="#000000"
                    android:textSize="18dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtUsuario" />

                <!-- Correo -->
                <TextView
                    android:id="@+id/txtNameCorreo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="15dp"
                    android:text="Correo Electrónico:"
                    android:textColor="@color/black"
                    android:textSize="14dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtNameUsuario" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEmailCrearNew"
                    android:layout_width="335dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="5dp"
                    android:hint="E-mail"
                    android:textColor="@color/black"
                    android:textColorHint="#000000"
                    android:textSize="18dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtNameCorreo" />

                <!-- SPINNER DE ZONA -->
                <TextView
                    android:id="@+id/txtZona"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="15dp"
                    android:text="Seleccione la Zona:"
                    android:textColor="@color/black"
                    android:textSize="14dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtEmailCrearNew" />

                <Spinner
                    android:id="@+id/spinnerMunicipios"
                    android:layout_width="335dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="5dp"
                    android:padding="10dp"
                    android:spinnerMode="dropdown"
                    android:background="@drawable/contenedores_diseno"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtZona" />

                <!-- Contraseña -->
                <TextView
                    android:id="@+id/txtNameContraseña"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="15dp"
                    android:text="Escriba Su Contraseña:"
                    android:textColor="@color/black"
                    android:textSize="14dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/spinnerMunicipios" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPassword"
                    android:layout_width="335dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="5dp"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtNameContraseña" />

                <CheckBox
                    android:id="@+id/showPasswordCheckBox"
                    android:layout_width="53dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="300dp"
                    android:button="@drawable/background_checkbox"
                    app:layout_constraintEnd_toEndOf="@id/edtPassword"
                    app:layout_constraintBottom_toBottomOf="@id/edtPassword"
                    app:layout_constraintTop_toTopOf="@id/edtPassword" />

                <!-- Confirmar Contraseña -->
                <TextView
                    android:id="@+id/txtNameContraseña3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="15dp"
                    android:text="Confirme Su Contraseña:"
                    android:textColor="@color/black"
                    android:textSize="14dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtPassword" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPasswordCrearNwe"
                    android:layout_width="335dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="5dp"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtNameContraseña3" />

                <CheckBox
                    android:id="@+id/showPasswordCheckBox2"
                    android:layout_width="53dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="300dp"
                    android:button="@drawable/background_checkbox"
                    app:layout_constraintEnd_toEndOf="@id/edtPasswordCrearNwe"
                    app:layout_constraintBottom_toBottomOf="@id/edtPasswordCrearNwe"
                    app:layout_constraintTop_toTopOf="@id/edtPasswordCrearNwe" />

                <!-- Botón -->
                <Button
                    android:id="@+id/btnCrearCuenta"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#ffffff"
                    android:text="Enviar"
                    android:textColor="@color/black"
                    android:textSize="30sp"
                    android:textStyle="bold|italic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/edtPasswordCrearNwe" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
