<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ws"
    tools:context=".RegistroForestAdmin">

    <View
        android:id="@+id/statusBarFake"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="#D7C2FF"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- ▒▒▒ BARRA DE NAVEGACIÓN REAL (COLOR LAVANDA CLARO) ▒▒▒ -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#DDE3FF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/statusBarFake">

        <!-- Botón redondeado -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/btnRegresar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/flecha_regresar"/>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <!-- Título manuscrito -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de plantas"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="@font/family"/>

        <Space
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

    </LinearLayout>
    <!-- ▒▒▒ CONTENIDO SCROLL ▒▒▒ -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navigationBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Nombre de la planta -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputNombrePlanta"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Nombre de la planta"
                android:textColorHint="#000000"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombrePlanta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="#000000"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Grosor -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputGrosor"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColorHint="#000000"
                android:hint="Grosor del tallo (cm)"
                app:layout_constraintTop_toBottomOf="@id/inputNombrePlanta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/inputAltura"
                app:layout_constraintHorizontal_chainStyle="spread">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGrosor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="#000000" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Altura -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputAltura"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColorHint="#000000"
                android:hint="Altura (cm)"
                app:layout_constraintTop_toBottomOf="@id/inputNombrePlanta"
                app:layout_constraintStart_toEndOf="@id/inputGrosor"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAltura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="#000000" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Número de hojas -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputHojas"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="#000000"
                android:layout_marginTop="16dp"
                android:hint="Número de hojas"
                app:layout_constraintTop_toBottomOf="@id/inputGrosor">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHojas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#000000" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Total plantas -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputTotalPlantas"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColorHint="#000000"
                android:hint="Total de plantas"
                app:layout_constraintTop_toBottomOf="@id/inputHojas">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTotalPlantas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#000000" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Selector de Imagen -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFoto"
                android:layout_width="match_parent"
                android:layout_height="275dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/inputTotalPlantas">

                <ImageView
                    android:id="@+id/imgPlanta"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_image_placeholder"
                    android:contentDescription="Imagen de la planta" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón seleccionar foto -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeleccionarFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Seleccionar foto desde galería"
                app:icon="@drawable/ic_image"
                app:iconGravity="start"
                app:layout_constraintTop_toBottomOf="@id/cardFoto" />

            <!-- Botón registrar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Registrar Planta"
                android:textAllCaps="false"
                app:icon="@drawable/ic_save"
                app:iconGravity="start"
                app:layout_constraintTop_toBottomOf="@id/btnSeleccionarFoto" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
