<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SuperAdmin"
    android:background="@drawable/ws">


    <!-- ▒▒▒ BARRA SUPERIOR LAVANDA ▒▒▒ -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#DDE3FF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:elevation="6dp">

        <!-- TÍTULO SUPER ADMIN -->
        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUPER ADMIN"
            android:textSize="26sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:fontFamily="@font/family"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <!-- Logout -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:elevation="5dp">

            <ImageView
                android:id="@+id/logOutExitSesion"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/cerrar_sesion"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ▒▒▒ LAYOUT PRINCIPAL ▒▒▒ -->
    <LinearLayout
        android:id="@+id/layoutPrincipal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:layout_marginTop="70dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/txtsuperusuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido Administrador"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/family"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/userActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hola, Usuario"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/family"
            android:layout_gravity="center_horizontal"/>

        <org.imaginativeworld.whynotimagecarousel.ImageCarousel
            android:id="@+id/carousel"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="20dp"
            android:elevation="4dp"/>

        <Button
            android:id="@+id/btnZonas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zonas"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:fontFamily="@font/family"
            android:textStyle="bold"
            android:layout_marginTop="25dp"
            android:elevation="4dp"/>
    </LinearLayout>

    <!-- ▒▒▒ LAYOUT ZONAS ▒▒▒ -->
    <LinearLayout
        android:id="@+id/layoutZonas"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:layout_marginTop="70dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBackFromZonas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:backgroundTint="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="@font/family"
            android:textColor="#000000"
            android:elevation="4dp"
            android:layout_marginBottom="12dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerZonas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- ▒▒▒ LAYOUT USUARIOS ▒▒▒ -->
    <LinearLayout
        android:id="@+id/layoutUsuarios"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:layout_marginTop="70dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBackFromUsuarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:backgroundTint="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="@font/family"
            android:textColor="#000000"
            android:elevation="4dp"
            android:layout_marginBottom="12dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerUsuarios"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- ▒▒▒ LAYOUT PLANTAS ▒▒▒ -->
    <LinearLayout
        android:id="@+id/layoutPlantas"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:layout_marginTop="70dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBackFromPlantas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:backgroundTint="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="@font/family"
            android:textColor="#000000"
            android:elevation="4dp"
            android:layout_marginBottom="12dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPlantas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
