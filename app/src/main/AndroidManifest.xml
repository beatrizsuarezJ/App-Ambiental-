<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ====== PERMISOS ====== -->

    <!-- Internet / Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cámara (obligatorio para CameraX) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Ubicación (si tu app lo necesita realmente) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 12 e inferiores: acceso a archivos -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 13+ (API 33) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ====== APLICACIÓN ====== -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon_forest_app"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChildCare"
        tools:targetApi="31">

        <!-- ==== ACTIVIDADES ==== -->
        <activity android:name=".PreviewActivity" android:exported="false" />
        <activity android:name=".CameraActivity" android:exported="false" />
        <activity android:name=".SuperAdmin" android:exported="false" />
        <activity android:name=".MisPlantasActivity" android:exported="false" />
        <activity android:name=".ListaDeProductores" android:exported="false" />
        <activity android:name=".DetallePlanta" android:exported="false" />
        <activity android:name=".ListaPlantas" android:exported="false" />
        <activity android:name=".ProductoresModerables_MiniAdmin" android:exported="false" />
        <activity android:name=".RegistroForestAdmin" android:exported="false" />
        <activity android:name=".GestionPlanta" android:exported="false" />
        <activity android:name=".Formulario_ChildCare_User" android:exported="false" />
        <activity android:name=".PruebaSubirImagen_ChildCare" android:exported="false" />
        <activity android:name=".InformacionDeNinos_ChildCare_User" android:exported="false" />
        <activity android:name=".Location_ChildCare_User" android:exported="false" />
        <activity android:name=".Index_ChildCare_User" android:exported="false" />
        <activity android:name=".Asistencia_ChildCare" android:exported="false" />
        <activity android:name=".Temperatura_ChildCare" android:exported="false" />
        <activity android:name=".Index_ChildCare" android:exported="false" />
        <activity android:name=".RecuperarPassword_ChildCare" android:exported="false" />
        <activity android:name=".ModificarUss" android:exported="false" />
        <activity android:name=".IniciarSesion_ChildCare" android:exported="false" />
        <activity android:name=".kidsDatos" android:exported="false" />
        <activity android:name=".CrearCuenta_ChildCare" android:exported="false" />

        <!-- SPLASH principal -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FILE PROVIDER (IMPORTANTE para CameraX y compartir fotos via URI) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.childcare.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- GOOGLE MAPS API KEY -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyANBh4MNW7zghpdKOzSpsTkuncsYs9GC6k" />

    </application>

</manifest>
